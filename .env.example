# USPTO Open Data Portal key (api.uspto.gov only)
USPTO_ODP_API_KEY=
# TSDR key (tsdrapi.uspto.gov only; separate credential)
USPTO_TSDR_API_KEY=
# EPO OPS OAuth2 client credentials
EPO_OPS_CLIENT_ID=
EPO_OPS_CLIENT_SECRET=
# Optional: OpenAlex key (own daily budget) and GitHub token (higher search limit)
OPENALEX_API_KEY=
GITHUB_TOKEN=
# Enable undocumented Patent Public Search and Trademark Search adapters
IP_ALLOW_UNOFFICIAL=0
# Optional aws-waf-token cookie for Trademark Search
TMSEARCH_WAF_TOKEN=
# Operational settings
IP_CACHE_DIR=
# Cache size cap in MB (oldest entries are evicted first)
IP_CACHE_MAX_MB=300
IP_INDEX_DB=
IP_TIMEOUT_MS=30000
IP_MAX_RETRIES=2
# 0 = do not read missing keys from the Windows user environment
IP_WINDOWS_ENV=
